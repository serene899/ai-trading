# ======================================
# Crypto Sim — Backend Environment Config
# ======================================
# Exchange: okx (默认) | binance
EXCHANGE=okx

# ★ 第一阶段红线：行情只用 OKX 公共接口，不需要、也不要填任何交易所 API Key。
# 本系统没有真实下单接口，任何 Key 都不会被读取。

# 登录验证（公网部署必填，本地调试可留空）
# 生成方式：在 backend 目录运行 python hash_password.py，按提示操作后把输出的三行粘进来。
AUTH_PASSWORD_HASH=
SESSION_SECRET=
REQUIRE_AUTH=1
# COOKIE_SECURE=1   # 部署在 HTTPS 后面时打开；本地 http 调试时不要加这行

# 模拟账户初始资金（USDT）
INITIAL_CAPITAL=10000

# 模拟交易成本 —— 让模拟结果更接近真实盘
# 手续费率（0.001 = 0.1%，币安/OKX 现货的典型值）
FEE_RATE=0.001
# 市价单滑点（0.0005 = 0.05%，买入成交价高一点、卖出成交价低一点）
SLIPPAGE_PCT=0.0005

# SQLite 数据文件路径
DB_PATH=./data.db

# 允许的前端跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 后端监听端口
BACKEND_PORT=8000
